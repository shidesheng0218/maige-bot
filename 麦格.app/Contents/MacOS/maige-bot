#!/bin/bash
# 麦格.app 启动器：服务没在跑就起服务，然后开窗口（Chrome app 模式优先，否则默认浏览器）
ROOT="${MAIGE_ROOT:-$HOME/Documents/minimax项目}"
PORT=17878
URL="http://127.0.0.1:$PORT/panel"
DATA="$ROOT/maige-bot/data/standalone"

NODE_BIN="$(command -v node || true)"
for c in /opt/homebrew/bin/node /usr/local/bin/node; do
  [ -x "$c" ] && NODE_BIN="$c" && break
done
if [ -z "$NODE_BIN" ]; then
  osascript -e 'display alert "麦格需要 Node.js" message "未找到 node，请先安装 Node.js。"' 2>/dev/null || true
  exit 1
fi

if ! curl -s --max-time 1 "http://127.0.0.1:$PORT/api/info" >/dev/null 2>&1; then
  mkdir -p "$DATA"
  nohup "$NODE_BIN" "$ROOT/miniapps/maige-bot/miniapp/node/standalone.mjs" >> "$DATA/server.log" 2>&1 &
  for _ in $(seq 1 40); do
    curl -s --max-time 1 "http://127.0.0.1:$PORT/api/info" >/dev/null 2>&1 && break
    sleep 0.25
  done
fi

if [ -d "/Applications/Google Chrome.app" ]; then
  open -na "Google Chrome" --args --app="$URL"
else
  open "$URL"
fi
